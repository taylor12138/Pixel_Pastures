; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="像素田园"
config/description="像素风田园休闲游戏"
run/main_scene="res://scenes/test/test_regression_runner.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
DataManager="*res://scripts/autoload/data_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
TimeManager="*res://scripts/autoload/time_manager.gd"
CropManager="*res://scripts/autoload/crop_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
EconomyManager="*res://scripts/autoload/economy_manager.gd"
LevelManager="*res://scripts/autoload/level_manager.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=320
window/size/window_width_override=1920
window/size/window_height_override=1280
window/stretch/mode="viewport"

